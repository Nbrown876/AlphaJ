Rule 4     statement -> declaration
Rule 5     statement -> assignment
Rule 6     statement -> broadcast_stmt
Rule 7     statement -> try_catch
Rule 8     statement -> if_stmt
Rule 9     statement -> cycle_stmt
Rule 10    statement -> NEWLINE
Rule 11    statement -> NOTES
Rule 12    assignment -> ID ASSIGNTO expression
Rule 13    assignment -> ID ASSIGNTO STRING
Rule 14    declaration -> YOUARE ID ASSIGNTO expression
Rule 15    declaration -> YOUARE ID ASSIGNTO STRING
Rule 16    broadcast_stmt -> BROADCAST broadcast_args
Rule 17    broadcast_args -> broadcast_arg
Rule 18    broadcast_args -> broadcast_args broadcast_arg
Rule 19    broadcast_arg -> STRING
Rule 20    broadcast_arg -> expression
Rule 21    try_catch -> TRY statement_list CATCH statement_list END
Rule 22    if_stmt -> IF condition statement_list END
Rule 23    if_stmt -> IF condition statement_list FALLBACK statement_list END
Rule 24    cycle_stmt -> CYCLE condition statement_list END
Rule 25    condition -> expression EQT expression
Rule 26    condition -> expression NEQT expression
Rule 27    condition -> expression LT expression
Rule 28    condition -> expression GT expression
Rule 29    condition -> expression LTE expression
Rule 30    condition -> expression GTE expression
Rule 31    expression -> expression PLUS term
Rule 32    expression -> expression MINUS term
Rule 33    expression -> term
Rule 34    term -> term TIMES factor
Rule 35    term -> term DIVIDE factor
Rule 36    term -> factor
Rule 37    factor -> base POWER factor
Rule 38    factor -> base
Rule 39    base -> NUMBER
Rule 40    base -> ID
Rule 41    base -> LT_PARENT expression RT_PARENT
Rule 42    base -> MINUS base

